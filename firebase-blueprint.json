{
  "entities": {
    "Book": {
      "title": "Book",
      "description": "Obra literária ou publicação em PDF no Ala X",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "synopsis": { "type": "string" },
        "category": { "type": "string" },
        "coverUrl": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "downloadCount": { "type": "number" },
        "likesCount": { "type": "number" },
        "ratingAverage": { "type": "number" },
        "ratingCount": { "type": "number" },
        "pageCount": { "type": "number" },
        "language": { "type": "string" },
        "publishedYear": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "uploadedBy": { "type": "string" }
      },
      "required": ["id", "title", "author", "synopsis", "category", "coverUrl", "pdfUrl", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Comentário e avaliação de uma obra",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "bookId", "userId", "userName", "rating", "comment", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "Perfil individual e privado de utilizador no Ala X",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "avatar": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "favoriteBookIds": { "type": "array" },
        "readHistory": { "type": "array" },
        "createdAt": { "type": "number" },
        "lastLogin": { "type": "number" }
      },
      "required": ["id", "uid", "email", "name", "role", "createdAt"]
    }
  },
  "firestore": {
    "books/{bookId}": {
      "schema": "Book",
      "description": "Coleção principal de obras publicadas"
    },
    "reviews/{reviewId}": {
      "schema": "Review",
      "description": "Avaliações e comentários das obras"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "Perfis isolados por UID de leitores e administradores"
    }
  }
}
